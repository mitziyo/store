<%- include('includes/header') %>

<link rel="stylesheet" type="text/css" href="/css/auth.css" />
<link rel="stylesheet" type="text/css" href="/css/home.css" />

<body>
  <div class="home-page">
    <div class="auth-topbar">
      <a class="auth-logo" href="/admin">
        <span class="auth-logo-mark">LB</span>
        LightBooks
      </a>
      <div class="auth-topbar-links">
        <a class="auth-topbar-link active" href="/admin">Home</a>
        <% if (typeof member === "undefined" || !member) { %>
        <a class="auth-topbar-link" href="/admin/login">Login</a>
        <a class="auth-topbar-link" href="/admin/signup">Signup</a>
        <% } else { %>
        <a class="auth-topbar-link" href="/admin/book/all">Books</a>
        <a class="auth-topbar-link" href="/admin/user/all">Users</a>
        <a
          class="auth-topbar-link"
          href="/admin/logout"
          onclick="return confirm('Do you want to logout?')"
        >Logout</a>
        <% } %>
      </div>
    </div>

    <div class="hero-banner">
      <div class="container">
        <div class="row align-items-center">
          <div class="col-lg-6">
            <div class="hero-banner__content">
              <span class="hero-banner__badge">
                <i class="fa-solid fa-store"></i>
                Store Admin Panel
              </span>
              <h1 class="hero-banner__title">
                Manage Your Bookstore <span>With Ease</span>
              </h1>
              <p class="hero-banner__text">
                Add new books, track orders, and grow your store — all from one simple dashboard.
              </p>

              <div class="hero-banner__buttons">
                <% if (typeof member === "undefined" || !member) { %>
                <a href="/admin/signup" class="btn-primary-hero">
                  <i class="fa-solid fa-store"></i>
                  Get Started
                </a>
                <a href="/admin/login" class="btn-secondary-hero">
                  <i class="fa-solid fa-right-to-bracket"></i>
                  Sign In
                </a>
                <% } else { %>
                <a href="/admin/book/all" class="btn-primary-hero">
                  <i class="fa-solid fa-book"></i>
                  Manage Books
                </a>
                <a href="/admin/user/all" class="btn-secondary-hero">
                  <i class="fa-solid fa-users"></i>
                  View Users
                </a>
                <% } %>
              </div>

              <div class="hero-banner__trust">
                <div class="trust-item">
                  <i class="fa-solid fa-shield-halved"></i>
                  <span>Secure Login</span>
                </div>
                <div class="trust-item">
                  <i class="fa-solid fa-bolt"></i>
                  <span>Real-time Updates</span>
                </div>
                <div class="trust-item">
                  <i class="fa-solid fa-wand-magic-sparkles"></i>
                  <span>Simple Management</span>
                </div>
              </div>
            </div>
          </div>

          <div class="col-lg-6">
            <div class="hero-banner__image">
              <img class="hero-banner__book" src="/img/hero-bookshop.jpg" alt="A charming bookshop storefront" />
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</body>

<%- include('includes/footer') %>
