<%- include('includes/header') %>

<link rel="stylesheet" type="text/css" href="/css/dashboard.css" />

<body>
  <div class="dash-layout">
    <%- include('includes/sidebar', { active: 'users' }) %>

    <div class="dash-main">
      <%- include('includes/topbar') %>

      <div class="dash-content">
        <div class="dash-content-header">
          <h1>Users</h1>
        </div>

        <div class="dash-table-card">
          <% if (users.length) { %>
          <table class="dash-table">
            <thead>
              <tr>
                <th>Member</th>
                <th>Phone</th>
                <th>Points</th>
                <th>Status</th>
                <th>Action</th>
              </tr>
            </thead>
            <tbody>
              <% users.forEach((u) => { %>
              <tr>
                <td>
                  <div class="dash-row-media">
                    <img class="dash-row-thumb round" src="/<%= u.memberImage || 'img/default.jpg' %>" alt="<%= u.memberNick %>" />
                    <%= u.memberNick %>
                  </div>
                </td>
                <td><%= u.memberPhone %></td>
                <td><%= u.memberPoints %></td>
                <td>
                  <select class="dash-status-select member-status-select <%= u.memberStatus === 'ACTIVE' ? 'process' : (u.memberStatus === 'BLOCK' ? 'pause' : 'delete') %>" id="<%= u._id %>">
                    <option value="ACTIVE" <%= u.memberStatus === 'ACTIVE' ? 'selected' : '' %>>ACTIVE</option>
                    <option value="BLOCK" <%= u.memberStatus === 'BLOCK' ? 'selected' : '' %>>BLOCK</option>
                    <option value="DELETE" <%= u.memberStatus === 'DELETE' ? 'selected' : '' %>>DELETE</option>
                  </select>
                </td>
                <td>
                  <div class="dash-row-actions">
                    <button
                      type="button"
                      title="Edit"
                      class="edit-user-btn"
                      data-id="<%= u._id %>"
                      data-nick="<%= u.memberNick %>"
                      data-phone="<%= u.memberPhone %>"
                      data-address="<%= u.memberAddress || '' %>"
                      data-desc="<%= u.memberDesc || '' %>"
                    >
                      <i class="fa-solid fa-pen"></i>
                    </button>
                  </div>
                </td>
              </tr>
              <% }) %>
            </tbody>
          </table>
          <% } else { %>
          <div class="dash-empty">No users yet.</div>
          <% } %>
        </div>

        <form class="dash-form-card user-form-card" style="display: none">
          <h2>Edit User</h2>
          <input type="hidden" class="user-id" />

          <div class="dash-form-row">
            <div class="dash-form-field">
              <label>Nickname</label>
              <input type="text" placeholder="Nickname" class="user-nick" />
            </div>
            <div class="dash-form-field">
              <label>Phone</label>
              <input type="text" placeholder="Phone" class="user-phone" />
            </div>
          </div>

          <div class="dash-form-row">
            <div class="dash-form-field full">
              <label>Address</label>
              <input type="text" placeholder="Address" class="user-address" />
            </div>
          </div>

          <div class="dash-form-row">
            <div class="dash-form-field full">
              <label>Description</label>
              <textarea class="user-desc"></textarea>
            </div>
          </div>

          <div class="dash-form-actions">
            <button type="button" class="dash-btn-secondary" id="user-cancel-btn">Cancel</button>
            <button type="submit" class="dash-btn-primary" id="user-update-btn">Update</button>
          </div>
        </form>
      </div>
    </div>
  </div>

  <script type="text/javascript" src="/js/users.js"></script>
</body>

<%- include('includes/footer') %>
